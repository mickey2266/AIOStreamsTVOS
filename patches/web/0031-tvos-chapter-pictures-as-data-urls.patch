 import { blobAddress, type BlobAddress } from '@/lib/artwork/shrink';
+import { appleTv } from '@/lib/hosts/shell/bridge';
 import type { PlayerEngine, Thumbnail } from './engine';
 
+/**
+ * Where a kept picture is shown from. The Apple TV app's WebKit draws a blob
+ * URL as a broken picture (as it does the artwork workers' and the saved
+ * artwork's), so there the picture is kept as a data URL (AIOStreamsTVOS).
+ */
+async function keptAddress(blob: Blob): Promise<BlobAddress> {
+  if (!appleTv()) return blobAddress(blob);
+  const src = await new Promise<string>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result));
+    reader.onerror = () => reject(reader.error);
+    reader.readAsDataURL(blob);
+  });
+  return { src, revoke: () => undefined };
+}
