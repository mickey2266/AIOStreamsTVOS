+/**
+ * `shown` for the hole in the page's background: on the Apple TV, two frames late as it turns on, and
+ * at once as it turns off. Its WebKit can draw the veil's first frame of the fade late, and the hole cut
+ * in that same frame bared the trailer's picture sharply along its edges, where only the veil covers
+ * it. Cut once the veil has drawn, the page background still covers the box until then (AIOStreamsTVOS).
+ */
+function useHoleOpen(shown: boolean): boolean {
+  const [late, setLate] = React.useState(false);
+  React.useEffect(() => {
+    if (!shown || !appleTv()) {
+      setLate(false);
+      return;
+    }
+    let frame = requestAnimationFrame(() => {
+      frame = requestAnimationFrame(() => setLate(true));
+    });
+    return () => cancelAnimationFrame(frame);
+  }, [shown]);
+  return appleTv() ? shown && late : shown;
+}
