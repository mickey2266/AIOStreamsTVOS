+        title={item.Name ?? ''}
+        subtitle={itemSubtitle(item)}
+        itemType={item.Type}
+        watched={item.UserData?.Played}
+        favourite={item.UserData?.IsFavorite}
+        unwatched={item.UserData?.UnplayedItemCount ?? undefined}
+        progress={progressOf(item)}
+      />
+    </ItemMenu>
+  );
+});
