+/**
+ * Cards within a screen's height of the screen are drawn; further out each
+ * holds its place empty. A TV's grid runs 10 or 12 across, and 2.5 screens
+ * each way kept 300 or more cards mounted; a held key's scroll trails focus
+ * by half a row, so one screen still mounts a row long before it's in sight.
+ */
+// eslint-disable-next-line lingui/no-unlocalized-strings -- a root margin
+const DRAWN_MARGIN = '100% 0px';
+/** Drawn before they're first measured, so a grid's first screen shows at once. */
+const FIRST_DRAWN = 30;
+
+/**
+ * An empty cell's size before any card has been measured: the art's shape,
+ * short of the caption by a little. A catalog restored from its saved copy
+ * comes with every page at once, and empty cells with no height would all
+ * sit at the top, near the screen, and be drawn together.
+ */
+const ESTIMATE = { poster: 'aspect-[2/3]', wide: 'aspect-video' };
+
+/**
+ * A grid's card, drawn only near the screen: a catalog pages on as it's
+ * scrolled, and every card it kept mounted would keep its elements and its
+ * artwork. Out of sight it keeps its height, or the grid's last known one.
+ */
+function GridCell({
+  index,
+  height,
+  shape,
+  children,
+}: {
+  index: number;
+  height: React.MutableRefObject<number>;
+  shape: keyof typeof ESTIMATE;
+  children: React.ReactNode;
+}) {
+  const ref = React.useRef<HTMLDivElement | null>(null);
+  const root = React.useContext(ScrollRoot);
+  const [shown, setShown] = React.useState(index < FIRST_DRAWN);
+  const [held, setHeld] = React.useState<number>();
+  const fade = fadeIn(index).ref;
+  const setRef = React.useCallback(
+    (el: HTMLDivElement | null) => {
+      ref.current = el;
+      fade(el);
+    },
+    [fade]
+  );
+  React.useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    return watch(el, root, DRAWN_MARGIN, (entry) => {
+      if (entry.isIntersecting) return setShown(true);
+      // Measured already, so reading it costs nothing.
+      const h = entry.boundingClientRect.height;
+      if (h > 0) {
+        height.current = h;
+        setHeld(h);
+      }
+      setShown(false);
+    });
+  }, [root, height]);
+  const kept = shown ? undefined : (held ?? (height.current || undefined));
+  return (
+    <div
+      ref={setRef}
+      className={shown || kept ? undefined : ESTIMATE[shape]}
+      style={kept ? { height: kept } : undefined}
+    >
+      {shown ? children : null}
+    </div>
+  );
+}
+
