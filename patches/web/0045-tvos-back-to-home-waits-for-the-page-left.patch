+/** How long Home waits, once the page left is gone, before it's drawn again. */
+const HOME_AFTER_MS = 100;
+
+/**
+ * Whether the kept Home is shown. On an Apple TV, going back to it waits until
+ * the page left has been taken down and a frame drawn without it, so WebKit
+ * can let go of that page before Home's pictures and layers are made again:
+ * both at once ended the page's process (AIOStreamsTVOS).
+ */
+function useHomeShown(onHome: boolean): boolean {
+  const staged = appleTv();
+  const [shown, setShown] = React.useState(onHome);
+  React.useEffect(() => {
+    if (!onHome) {
+      setShown(false);
+      return;
+    }
+    if (!staged) return;
+    let timer = 0;
+    const frame = requestAnimationFrame(() => {
+      timer = window.setTimeout(() => setShown(true), HOME_AFTER_MS);
+    });
+    return () => {
+      cancelAnimationFrame(frame);
+      clearTimeout(timer);
+    };
+  }, [onHome, staged]);
+  return onHome && (!staged || shown);
+}
+
+/**
+ * The page shown other than Home. On an Apple TV a new page waits, as Home
+ * does, until the page it replaces has been taken down and a frame drawn
+ * without it: one title page built as the last was let go, a few in quick
+ * succession, ended the page's process (AIOStreamsTVOS).
+ */
+function useStagedPath(pathname: string): string | undefined {
+  const staged = appleTv();
+  const [shown, setShown] = React.useState(pathname);
+  React.useEffect(() => {
+    if (!staged) return;
+    let timer = 0;
+    const frame = requestAnimationFrame(() => {
+      timer = window.setTimeout(() => setShown(pathname), HOME_AFTER_MS);
+    });
+    return () => {
+      cancelAnimationFrame(frame);
+      clearTimeout(timer);
+    };
+  }, [pathname, staged]);
+  if (!staged) return pathname;
+  return shown === pathname ? pathname : undefined;
+}
+
 function pageName(pathname: string): string {
   return pathname.split('/')[1] || 'home';
 }
