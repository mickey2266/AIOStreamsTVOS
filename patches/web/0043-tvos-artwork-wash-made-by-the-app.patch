+/**
+ * Made by the Apple TV app, from the same steps, at `/wash?u=<address>` on the
+ * page's own scheme: a PNG, with its colours in `X-Wash-Tint` and
+ * `X-Wash-Panel`. That WebKit doesn't start the artwork workers for the app's
+ * scheme, so each change of background was made on the page's own thread
+ * (AIOStreamsTVOS).
+ */
+async function washInApp(src: string): Promise<WashFrame | null> {
+  const address = new URL(src, location.href).href;
+  const res = await fetch(`/wash?u=${encodeURIComponent(address)}`);
+  const tint = res.headers.get('X-Wash-Tint');
+  const panel = res.headers.get('X-Wash-Panel');
+  if (!res.ok || !tint || !panel) return null;
+  const image = await createImageBitmap(await res.blob());
+  return { src, image, tint, panel };
+}
