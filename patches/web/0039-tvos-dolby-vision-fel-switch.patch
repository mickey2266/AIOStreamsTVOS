+/**
+ * The Apple TV app's Dolby Vision Profile 7 FEL switch (`settings.video.dolbyVisionFel`, AIOStreamsTVOS).
+ * Shown only under the Dolby Vision switch, which it depends on. In English only, as the help above.
+ */
+function DolbyVisionFelSwitch() {
+  const [fel, setFel] = useSetting(settings.video.dolbyVisionFel);
+  return (
+    <Switch
+      side="right"
+      label="Dolby Vision profile 7 FEL"
+      help="Plays profile 7 videos with a full enhancement layer (some UHD Blu-ray remuxes) with that layer folded into the picture's brightness curves, so a Dolby Vision TV shows more of the disc's detail. Starts and seeks take a little longer."
+      value={fel}
+      onValueChange={setFel}
+    />
+  );
+}
