+/**
+ * The longest work waits for scrolls to end: a held key keeps one running,
+ * and what waits must still come in time (AIOStreamsTVOS).
+ */
+const STILL_MOST_MS = 700;
+const stillWaiting = new Set<() => void>();
+
+/**
+ * Runs `run` once no keyed scroll is under way, or after `STILL_MOST_MS`.
+ * A scroll eased frame by frame stalls on any long task, so work that can
+ * wait, such as mounting a row's cards, waits for it to stop.
+ */
+export function whenStill(run: () => void): () => void {
+  let done = false;
+  const go = () => {
+    if (done) return;
+    done = true;
+    stillWaiting.delete(go);
+    clearTimeout(timer);
+    run();
+  };
+  const timer = setTimeout(go, glides.size ? STILL_MOST_MS : 0);
+  if (glides.size) stillWaiting.add(go);
+  return () => {
+    done = true;
+    stillWaiting.delete(go);
+    clearTimeout(timer);
+  };
+}
+
+/** After the frame the last scroll ended in, so it's drawn first. */
+function wakeStill(): void {
+  if (!stillWaiting.size) return;
+  const waiting = [...stillWaiting];
+  stillWaiting.clear();
+  setTimeout(() => waiting.forEach((go) => go()));
+}
