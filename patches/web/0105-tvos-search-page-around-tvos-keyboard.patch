+/**
+ * The Apple TV app's Search page, laid out around tvOS's own search keyboard, which the app shows
+ * in the page's place (AIOStreamsTVOS): the linear keyboard across the top, the grid one down the
+ * left, with the field and "Hold to dictate" above either, as tvOS's own search screen has them.
+ * The page leaves the keyboard's space empty but for one focus target (`tvos-search-keys`), which
+ * hands the remote to the keyboard as focus reaches it, and draws the history and the server's
+ * suggestions as a row of chips, then the results, in the space tvOS gives its results
+ * (`--tvos-results-x`, `--tvos-results-y`, which the bridge script sets from the app's measure).
+ * Its own field stays, unseen, for the keyboard to type into.
+ */
+function AppleTvSearch({
+  field,
+  chips,
+  results,
+}: {
+  field: React.ReactNode;
+  chips: React.ReactNode;
+  results: React.ReactNode;
+}) {
+  return (
+    <div
+      data-ui="search-page"
+      // The page's own height below its top, so only the results scroll, under the keyboard's space.
+      className="relative -mb-16 h-[calc(100dvh-var(--tvos-search-top,6rem))]"
+    >
+      <div className="hidden">{field}</div>
+      <button
+        type="button"
+        data-ui="tvos-search-keys"
+        data-focus="own"
+        aria-label={t`Search`}
+        className="absolute start-0 top-0 h-[var(--tvos-results-y,22rem)] w-full outline-none [[data-keys=grid]_&]:h-full [[data-keys=grid]_&]:w-[var(--tvos-results-x,34rem)]"
+      />
+      <div
+        data-ui="search-results-area"
+        className="absolute bottom-0 end-0 start-[var(--tvos-results-x,0px)] top-[var(--tvos-results-y,22rem)] space-y-8 overflow-y-auto pb-16 pt-6"
+      >
+        {chips}
+        {results}
+      </div>
+    </div>
+  );
+}
+
+/** A row of chips: the history's, or the server's suggestions while typing (AIOStreamsTVOS). */
+function Chips({ children }: { children: React.ReactNode }) {
+  return (
+    <div
+      data-ui="search-chips"
+      data-nav-row=""
+      className="flex flex-wrap items-center gap-3"
+    >
+      {children}
+    </div>
+  );
+}
+
+const Chip = React.forwardRef<
+  HTMLButtonElement,
+  React.ButtonHTMLAttributes<HTMLButtonElement> & {
+    icon?: React.ReactElement<{ className?: string }>;
+    label: string;
+    outlined?: boolean;
+  }
+>(function Chip({ icon, label, outlined, className, ...props }, ref) {
+  return (
+    <button
+      ref={ref}
+      type="button"
+      data-focus="own"
+      className={cn(
+        'flex max-w-xs items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors focus-visible:bg-white focus-visible:text-black focus-visible:outline-none',
+        outlined ? 'ring-2 ring-inset ring-white/60' : 'bg-white/10',
+        className
+      )}
+      {...props}
+    >
+      {icon &&
+        React.cloneElement(icon, { className: 'flex-none text-base opacity-80' })}
+      <span className="truncate">{label}</span>
+    </button>
+  );
+});
