+import React from 'react';
+
+/** The size a wash is drawn at, before it's stretched over its box. */
+const WASH_WIDTH = 12;
+const WASH_HEIGHT = 18;
+
+/**
+ * A blurred wash of a picture's colours for a TV: the picture drawn a few
+ * pixels wide on a canvas and stretched, which blurs it as a CSS blur does,
+ * but once. A CSS blur is drawn again on each frame the page, or anything
+ * over it, moves, which a TV can't keep up with.
+ */
+export function DrawnWash({
+  src,
+  className,
+  onLoad,
+  onError,
+  ...rest
+}: {
+  src: string;
+  className: string;
+  onLoad?(): void;
+  onError?(): void;
+} & Omit<
+  React.CanvasHTMLAttributes<HTMLCanvasElement>,
+  'onLoad' | 'onError' | 'className' | 'width' | 'height'
+>) {
+  const canvas = React.useRef<HTMLCanvasElement>(null);
+  const latest = React.useRef({ onLoad, onError });
+  latest.current = { onLoad, onError };
+  React.useEffect(() => {
+    const img = new Image();
+    img.decoding = 'async';
+    img.onload = () => {
+      const ctx = canvas.current?.getContext('2d');
+      if (!ctx) return latest.current.onError?.();
+      ctx.clearRect(0, 0, WASH_WIDTH, WASH_HEIGHT);
+      ctx.imageSmoothingQuality = 'high';
+      // eslint-disable-next-line lingui/no-unlocalized-strings -- a CSS filter
+      if ('filter' in ctx) ctx.filter = 'saturate(1.5)';
+      ctx.drawImage(img, 0, 0, WASH_WIDTH, WASH_HEIGHT);
+      latest.current.onLoad?.();
+    };
+    img.onerror = () => latest.current.onError?.();
+    img.src = src;
+    return () => {
+      img.onload = null;
+      img.onerror = null;
+    };
+  }, [src]);
+  return (
+    <canvas
+      {...rest}
+      ref={canvas}
+      aria-hidden
+      width={WASH_WIDTH}
+      height={WASH_HEIGHT}
+      className={className}
+    />
+  );
+}
