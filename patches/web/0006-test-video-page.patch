+import { t } from '@lingui/core/macro';
+import { Trans } from '@lingui/react/macro';
+import React from 'react';
+import { BiArrowBack } from 'react-icons/bi';
+import { Button } from '@aiostreams/ui/button';
+import { cn } from '@aiostreams/ui/core/styling';
+import { useSession } from '@/lib/jellyfin/session';
+import { currentHost } from '@/lib/hosts';
+import { usePlayerFullscreen } from '@/lib/playback/fullscreen';
+import { usePlayer } from '@/lib/playback/use-player';
+import { videoEngine } from '@/lib/playback/video';
+import { useNowPlaying } from '@/lib/playback/now-playing';
+import { useAction } from '@/lib/input';
+import { settings, useSetting } from '@/lib/settings';
+import {
+  usePlaybackPrefs,
+  type PlaybackPrefs,
+} from '@/lib/jellyfin/user-config';
+import { goBack, to } from '@/lib/paths';
+import { closePlayback } from '@/lib/playback/session';
+import type { BaseItemDto, SourceInfo } from '@/lib/jellyfin/types';
+import { PlayerControls } from '@/features/player/controls';
+import { Cover } from '@/features/player/cover';
+import { OBJECT_FIT, usePlayerPage } from '@/app/player/page';
+
+/*
+ * A video from a bare http(s) link in the full player, for the Apple TV app's
+ * "Play a test video": no item on the server, so nothing is reported to it,
+ * as with a trailer. The app's now-playing item goes out, so the app's own
+ * controls (picture in picture, the remote's media keys) work on it too.
+ */
+
+const TEST_ID = 'test-video';
+
+/** The link's file name, for a title when none is given. */
+function nameOf(url: string): string {
+  try {
+    const path = new URL(url).pathname;
+    return decodeURIComponent(path.slice(path.lastIndexOf('/') + 1)) || url;
+  } catch {
+    return url;
+  }
+}
+
+export function TestVideoPage({ url, title }: { url: string; title: string }) {
+  usePlayerPage();
+  const host = currentHost();
+  usePlayerFullscreen(!host.player || !!host.fullscreen);
+  // The one player can't play both.
+  React.useEffect(closePlayback, []);
+  const prefs = usePlaybackPrefs();
+  const item = React.useMemo<BaseItemDto>(
+    () => ({ Id: TEST_ID, Name: title || nameOf(url) }),
+    [url, title]
+  );
+  const back = () => goBack(to.home);
+  if (!/^https?:\/\//i.test(url))
+    return (
+      <TestVideoFailure
+        message={t`A test video needs an http(s) link.`}
+        onBack={back}
+      />
+    );
+  if (prefs.isLoading) return <Cover item={item} />;
+  return (
+    <PlayedTestVideo item={item} url={url} prefs={prefs.prefs} onBack={back} />
+  );
+}
+
+function PlayedTestVideo({
+  item,
+  url,
+  prefs,
+  onBack,
+}: {
+  item: BaseItemDto;
+  url: string;
+  prefs: PlaybackPrefs;
+  onBack(): void;
+}) {
+  const { client } = useSession();
+  const video = React.useRef<HTMLVideoElement>(null);
+  const [hostPlayer] = React.useState(() => currentHost().player);
+  const [fit] = useSetting(settings.video.fit);
+  const [subtitleStyle] = useSetting(settings.subtitle.style);
+  const source = React.useMemo<SourceInfo>(
+    () => ({ Id: `${TEST_ID}:${url}`, MediaStreams: [] }),
+    [url]
+  );
+  const player = usePlayer([hostPlayer ?? videoEngine(video)], {
+    client,
+    item,
+    url,
+    source,
+    startMs: 0,
+    onEnded: onBack,
+    prefs,
+    subtitleStyle,
+  });
+  useNowPlaying(item, player, { onStop: onBack });
+  const failure = player.state.error ?? '';
+  return (
+    <div
+      data-page="player"
+      data-name="test-video"
+      className={cn('fixed inset-0', !hostPlayer && 'bg-black')}
+    >
+      {hostPlayer ? (
+        <Cover item={item} hidden={player.state.started} />
+      ) : (
+        <video
+          ref={video}
+          data-ui="video"
+          className={cn('h-full w-full', OBJECT_FIT[fit])}
+          autoPlay
+          playsInline
+        />
+      )}
+      {player.state.error ? (
+        <TestVideoFailure
+          message={t`The test video didn't play: ${failure}`}
+          onBack={onBack}
+        />
+      ) : (
+        <PlayerControls
+          item={item}
+          player={player}
+          onBack={onBack}
+        />
+      )}
+    </div>
+  );
+}
+
+function TestVideoFailure({
+  message,
+  onBack,
+}: {
+  message: string;
+  onBack(): void;
+}) {
+  useAction('back', onBack);
+  return (
+    <div
+      data-ui="player-error"
+      className="fixed inset-0 z-20 flex items-center justify-center bg-black/90 p-6"
+    >
+      <div className="max-w-md space-y-4 text-center">
+        <p className="text-lg font-semibold [overflow-wrap:anywhere]">
+          {message}
+        </p>
+        <Button
+          intent="white"
+          className="rounded-full"
+          leftIcon={<BiArrowBack className="rtl:-scale-x-100" />}
+          autoFocus
+          onClick={onBack}
+        >
+          <Trans>Back</Trans>
+        </Button>
+      </div>
+    </div>
+  );
+}
