+ * as does Down into the row from above (AIOStreamsTVOS).
+ */
+const inTitle = (el: Element) => !!el.closest('[data-nav=title]');
+
+/** The link in a row's title, where focus can reach it. */
+function titleOf(group: Element | null | undefined): HTMLElement | null {
+  const title = group
+    ?.querySelector('[data-nav=title]')
+    ?.querySelector<HTMLElement>(FOCUSABLE);
+  return title && canFocus(title) ? title : null;
+}
+
+/** Up from a row's cards, its title, however far along the row focus is. */
+function titleAbove(from: HTMLElement, dir: Direction): HTMLElement | null {
+  if (dir !== 'up' || inTitle(from) || !from.closest('[data-nav-row]'))
+    return null;
+  return titleOf(from.closest(GROUP));
+}
