+/** Down into a row from outside it, its title first. */
+function titleBelow(to: HTMLElement, from: HTMLElement, dir: Direction) {
+  if (dir !== 'down') return null;
+  const group = to.closest(GROUP);
+  return group && !group.contains(from) ? titleOf(group) : null;
+}
