+/**
+ * A row's title (`data-nav=title`), a link to the row's whole catalog: Up
+ * from any of the row's cards goes to it, Down from it comes back, and
+ * moving from row to row passes it by (AIOStreamsTVOS).
+ */
+const inTitle = (el: Element) => !!el.closest('[data-nav=title]');
+
+/** Another row's title, which focus moving from row to row passes by. */
+const otherTitle = (el: HTMLElement, from: HTMLElement) =>
+  inTitle(el) && !el.closest(GROUP)?.contains(from);
+
+/** Up from a row's cards, its title, however far along the row focus is. */
+function titleAbove(from: HTMLElement, dir: Direction): HTMLElement | null {
+  if (dir !== 'up' || inTitle(from) || !from.closest('[data-nav-row]'))
+    return null;
+  const title = from
+    .closest(GROUP)
+    ?.querySelector('[data-nav=title]')
+    ?.querySelector<HTMLElement>(FOCUSABLE);
+  return title && canFocus(title) ? title : null;
+}
