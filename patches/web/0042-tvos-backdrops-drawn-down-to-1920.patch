+/**
+ * The widest an Apple TV shows a picture, in device pixels: its screen's
+ * 1920. Wider ones are drawn down to it before they're shown (AIOStreamsTVOS).
+ */
+const FIT_PX = 1920;
+
+/**
+ * `src` no wider than the screen, made by the Apple TV app (its ImageFit, at
+ * `/fit/<width>?u=<address>` on the page's own scheme). Some servers send a
+ * backdrop's original, 3000 or more wide, whatever width is asked, and WebKit
+ * holds each decoded at that size; the app decodes it at the smaller size
+ * itself, so neither process holds the whole picture (AIOStreamsTVOS).
+ */
+function fitted(src: string | undefined): string | undefined {
+  if (!src) return src;
+  try {
+    const address = new URL(src, location.href);
+    if (address.protocol !== 'https:' && address.protocol !== 'http:') return src;
+    const fit = new URL(`/fit/${FIT_PX}`, location.href);
+    fit.searchParams.set('u', address.href);
+    return fit.href;
+  } catch {
+    return src;
+  }
+}
 
